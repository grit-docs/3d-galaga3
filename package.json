{
  "name": "halcyon-break",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HALCYON BREAK - original 3D roguelite arcade space shooter (Three.js + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.49.0",
    "@types/three": "^0.169.0",
    "eslint": "^9.27.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  }
}
